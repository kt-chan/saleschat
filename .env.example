# ==================== LLM ====================
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_CONCURRENCY=16
LLM_TIMEOUT=60
LLM_RETRY_MAX=3
LLM_RETRY_BACKOFF=2.0
LLM_TEMPERATURE_LABELING=0.1
LLM_TEMPERATURE_SYNTHESIS=0.3

# ================= Embedding (common) =================
EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5

# 在线 embedding 缓存条数（LRU）；高频相似 query 场景可调大
EMBED_CACHE_SIZE=2000

# 按长度排序后再分块，减少 padding 浪费
EMBEDDING_SORT_BY_LENGTH=true

# ================= Embedding — 远程服务 =================
# 本地开发：指向本机 TEI 容器（compose 暴露 8010）
# Kubernetes：由 ConfigMap 注入 http://tei:80/v1/embeddings，无需改 .env-sample
EMBEDDING_TEI_URL=http://127.0.0.1:8010/v1/embeddings
EMBEDDING_TEI_STYLE=auto
EMBEDDING_TEI_TIMEOUT=30
EMBEDDING_TEI_BATCH_SIZE=16
EMBEDDING_TEI_CONCURRENCY=8
EMBEDDING_TEI_RETRY_MAX=3
EMBEDDING_TEI_RETRY_BACKOFF=2.0
EMBEDDING_TEI_TRUNCATE=true

# ==================== Dialog parsing ====================
DIALOG_PARSE_MODE=auto
DIALOG_TURN_SEPARATORS='["；", ";"]'
DIALOG_ROLE_PREFIXES='["催收员", "客户", "客服", "坐席", "用户"]'
DIALOG_ROLE_ALIASES='{"客服": "催收员", "坐席": "催收员", "用户": "客户"}'
DIALOG_COLON_PATTERN='[：:]'
DIALOG_CUSTOMER_ROLE=客户
DIALOG_AGENT_ROLE=催收员

# ==================== Rewrite prefixes ====================
PROMPT_CUSTOMER_PREFIX=客户：
PROMPT_AGENT_PREFIX=催收员：

# ==================== Runtime mode ====================
# off     : no graph, unrestricted pgvector-equivalent retrieval only
# guide   : graph-aware, soft steering, allows cross-stage jumps (default)
# enforce : hard block — pins to stage_hint (or pass-1 stage), rejects on any failure
STATE_MACHINE_MODE=guide
CLEAR_CACHE_ON_START=false

# ==================== DB (standalone Docker PostgreSQL) ====================
# 由 docker-compose.yml 提供的独立 Postgres（不含 pgvector）。
# 启动：docker compose up -d
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cca_db
DB_USER=cca_user
DB_PASSWORD=cca_pass
DB_POOL_MIN=2
DB_POOL_MAX=50
DB_WRITE_BATCH_SIZE=500
SESSION_TTL=1800

# ==================== Paths ====================
DATA_DIR=./data/202610
OUTPUT_DIR=./output
CACHE_DIR=./cache
LOG_DIR=./log
CALLS_FILE_PATTERN=part_*.jsonl
PROMPT_FILE=./prompts.yaml

# ==================== Retrieval ====================
LOG_LEVEL=INFO
ONLINE_TOP_K=3
ONLINE_SIM_THRESHOLD=0.50

HYBRID_MAX_HOPS=2
HYBRID_GOLDEN_WEIGHT=1.0
HYBRID_PG_WEIGHT=0.9
HYBRID_PG_TOP_K=20
HYBRID_GOLDEN_TOP_K_PER_NODE=2
HYBRID_HOP_DECAY='[1.0, 0.95, 0.85]'
HYBRID_VOTE_TOP_N=5

# ==================== Suggest ====================
SUGGEST_CONTEXT_CUSTOMER_TURNS=3
SUGGEST_MAX_QUERY_CHARS=1000
SUGGEST_FALLBACK_SCRIPT=抱歉，我这边需要先核实一下信息，请您稍等片刻。

# ==================== Golden synthesis ====================
GOLDEN_EXACT_PER_TAG=3
GOLDEN_EXACT_LIMIT=20
GOLDEN_FUZZY_PER_INTENT=2
GOLDEN_FUZZY_LIMIT=10

# ==================== Demo ====================
DEMO_TEXT=
DEMO_TEXT_FILE=./data/demo_text.txt