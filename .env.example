# ==================== LLM 配置 ====================
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_CONCURRENCY=16

# ==================== 模型配置 ====================
EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=256

# ==================== 嵌入式本地服务开关 ====================
USE_EMBEDDED_DB=true
USE_EMBEDDED_REDIS=true

# ==================== 数据清理开关 ====================
# 开启后，每次离线运行都会彻底清空本地的 output、cache 目录以及数据库表
CLEAR_CACHE_ON_START=false

# ==================== 状态机拦截配置 ====================
ENABLE_STATE_MACHINE=false

# ==================== 外部数据库配置 (如果关闭了嵌入式，这里生效) ====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cca_db
DB_USER=cca_user
DB_PASSWORD=cca_pass
DB_POOL_MIN=2
DB_POOL_MAX=50

# ==================== Redis 配置 ====================
REDIS_URL=redis://localhost:6379/0
SESSION_TTL=1800

# ==================== 路径配置 ====================
DATA_DIR=./data
OUTPUT_DIR=./output
CACHE_DIR=./cache
LOG_DIR=./log
CALLS_FILE=./data/calls.json
PROMPT_FILE=./prompts.yaml
SOP_GRAPH_FILE=./data/sop_graph.json

# ==================== 日志配置 ====================

# ==================== 在线参数 ====================
LOG_LEVEL=INFO
ONLINE_TOP_K=3
ONLINE_RECALL_TOP_K=10
ONLINE_SIM_THRESHOLD=0.50
ONLINE_CONTEXT_WINDOW=2