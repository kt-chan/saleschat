# syntax=docker/dockerfile:1.7
FROM python:3.12-slim

# 与生产镜像保持完全一致的路径语义
ENV HF_HOME=/app/models/huggingface \
    HF_HUB_DISABLE_PROGRESS_BARS=1

WORKDIR /app

# 只装下载器，不装 torch / sentence-transformers
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir "huggingface_hub>=0.30"

COPY models.txt download_models.sh ./

# 与生产 Dockerfile 完全相同的下载步骤
RUN --mount=type=secret,id=HF_TOKEN,required=false \
    chmod +x download_models.sh && \
    ./download_models.sh models.txt

# 离线验证：新进程 + HF_HUB_OFFLINE=1，确保环境变量在 import 前生效
RUN HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 python - <<'PY'
import os
from pathlib import Path
from huggingface_hub import snapshot_download

hf_home = Path(os.environ["HF_HOME"])
hub = hf_home / "hub"
assert hub.is_dir(), f"missing hub dir: {hub}"

specs = []
for line in Path("models.txt").read_text().splitlines():
    entry = line.split("#", 1)[0].strip()
    if entry:
        specs.append(entry)
assert specs, "empty manifest"

for spec in specs:
    rid, _, rev = spec.partition("@")
    repo_dir = hub / ("models--" + rid.replace("/", "--"))
    assert repo_dir.is_dir(), f"missing cache for {rid}: {repo_dir}"

    snaps = [p for p in (repo_dir / "snapshots").iterdir() if p.is_dir()]
    assert snaps, f"no snapshot for {rid}"
    for snap in snaps:
        files = [p for p in snap.rglob("*") if p.is_file()]
        assert files, f"empty snapshot: {snap}"
        print(f"ok {rid}: {len(files)} files @ {snap.name}")

    # 第二次调用必须命中缓存、不联网
    path = snapshot_download(
        rid,
        revision=rev or None,
        cache_dir=str(hf_home),
        local_files_only=True,
    )
    print(f"offline hit: {rid} -> {path}")

print("ALL MODEL CHECKS PASSED")
PY