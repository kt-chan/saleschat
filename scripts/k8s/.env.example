# ============================================================
# CCA Kubernetes 配置 —— 复制为 .env 后修改
# ============================================================

# --- LLM ---
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=GLM-4-FlashX-250414
LLM_API_KEY=sk-REPLACE_ME


# --- 本地数据 ---
DATA_DIR_LOCAL=$HOME/app/saleschat/data/202610
DATA_DIR_BATCH=202610
CALLS_FILE_PATTERN=*.jsonl


# --- Runtime ---
CLEAR_CACHE_ON_START=false
STATE_MACHINE_MODE=guide
LOG_LEVEL=INFO


# --- 环境 ---
STORAGE_CLASS=standard
IMAGE_PULL_POLICY=Never

# --- Namespaces ---
NS=cca
INFRA_PG_NS=gv
INFRA_TEI_NS=model-service

# --- 镜像 ---
APP_IMAGE=ghcr.io/kt-chan/saleschat-amd64:latest
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:89-1.9

# --- PostgreSQL ---
INFRA_PG_SVC=gv-sql-service
INFRA_PG_PORT=14003
DB_HOST=gv-sql-service.gv.svc.cluster.local
DB_PORT=14003
DB_NAME=cca_db
DB_USER=cca_user
DB_PASSWORD=cca_pass

# --- TEI ---
INFRA_TEI_SVC=tei-svc
INFRA_TEI_DEPLOY=tei-svc
INFRA_TEI_LABEL=tei
INFRA_TEI_PORT=8010
EMBEDDING_TEI_URL=http://tei-svc.model-service.svc.cluster.local:8010/v1/embeddings
EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
EMBEDDING_TEI_STYLE=auto


# --- Port-forward ---
PF_PORT=8000
PF_ADDRESS=127.0.0.1

# --- 本地模型 ---
MODEL_ID=BAAI/bge-base-zh-v1.5
MODEL_DIR_NAME=models--BAAI--bge-base-zh-v1.5
MODEL_SHORT_NAME=bge-base-zh-v1.5
HF_CACHE_DIR=$HOME/app/saleschat/models/huggingface
