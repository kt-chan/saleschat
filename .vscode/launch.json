{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Main: 全流程 (offline + online)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app/main.py",
      "args": ["--mode", "all"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONUNBUFFERED": "1",
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "preLaunchTask": "Stack: Up",
      "justMyCode": false,
      "python": "${command:python.interpreterPath}"
    },
    {
      "name": "Main: 仅离线",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app/main.py",
      "args": ["--mode", "offline"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONUNBUFFERED": "1"
      },
      "preLaunchTask": "Stack: Up",
      "justMyCode": false
    },
    {
      "name": "Main: 仅在线",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app/main.py",
      "args": ["--mode", "online"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONUNBUFFERED": "1"
      },
      "preLaunchTask": "Stack: Up",
      "justMyCode": false
    },
    {
      "name": "Server: FastAPI (调试)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app/server.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONUNBUFFERED": "1",
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "preLaunchTask": "Stack: Up",
      "justMyCode": false
    },
    {
      "name": "Server: FastAPI (热重载，uvicorn --reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.server:app",
        "--host", "0.0.0.0",
        "--port", "8000",
        "--reload",
        "--reload-dir", "${workspaceFolder}/app",
        "--log-level", "info"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONUNBUFFERED": "1"
      },
      "preLaunchTask": "Stack: Up",
      "subProcess": true,
      "justMyCode": false
    },
    {
      "name": "Evaluate: 评测",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app/evaluate.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONUNBUFFERED": "1"
      },
      "preLaunchTask": "Stack: Up",
      "justMyCode": false
    },
    {
      "name": "Offline: 单步调试（断点用）",
      "type": "debugpy",
      "request": "launch",
      "module": "offline",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "preLaunchTask": "Stack: Up",
      "justMyCode": false
    },
    {
      "name": "Online: 单步调试（断点用）",
      "type": "debugpy",
      "request": "launch",
      "module": "online",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "preLaunchTask": "Stack: Up",
      "justMyCode": false
    },
    {
      "name": "Pytest: 当前文件",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v", "-s"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "preLaunchTask": "Stack: Up",
      "justMyCode": false
    },
    {
      "name": "Python: 当前文件",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "justMyCode": false
    }
  ],
  "compounds": [
    {
      "name": "Compound: 离线后在线",
      "configurations": ["Main: 仅离线"],
      "stopAll": true
    }
  ]
}